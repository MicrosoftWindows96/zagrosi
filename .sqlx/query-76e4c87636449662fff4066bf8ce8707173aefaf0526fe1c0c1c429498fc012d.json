  "query": "\n        SELECT id, display_name, scopes, allowed_cidrs, tolerant_mode,\n               last_used_at, last_used_ip, created_at, expires_at,\n               revoked_at, deleted_at\n        FROM scim_tokens\n        WHERE org_id = $1 AND deleted_at IS NULL\n        ORDER BY created_at DESC\n        ",
