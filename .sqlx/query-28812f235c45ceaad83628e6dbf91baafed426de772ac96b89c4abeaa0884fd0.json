{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT m.id, m.group_id, m.user_id, m.created_at, m.deleted_at\n            FROM group_memberships m\n            JOIN groups g ON g.id = m.group_id\n            WHERE g.org_id = $1\n              AND m.group_id = $2\n              AND m.deleted_at IS NULL\n              AND g.deleted_at IS NULL\n            ",
