  "query": "\n            SELECT id, org_id, display_name, external_id, row_version,\n                   created_at, updated_at, deleted_at\n            FROM groups\n            WHERE org_id = $1 AND deleted_at IS NULL\n            ORDER BY id ASC\n            OFFSET $2 LIMIT $3\n            ",
