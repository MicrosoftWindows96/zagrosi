# Patterns to ignore when building Helm packages.
.DS_Store
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
*.swp
*.bak
*.tmp
*.orig
*~
.idea/
.vscode/
.project
ci/
.github/
README.md.gotmpl

# Sensitive patterns (defense-in-depth: never let a stray secret slip into a chart package).
.env
.env.*
*.env
*.key
*.pem
*.crt
*.p12
*.pfx
*.kubeconfig
kubeconfig
*.tfstate
*.tfvars
secrets.yaml
*-secret.yaml
