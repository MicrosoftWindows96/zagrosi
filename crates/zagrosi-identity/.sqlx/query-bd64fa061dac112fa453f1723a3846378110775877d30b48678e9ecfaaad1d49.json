{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE groups\n            SET display_name = $3,\n                external_id = $4,\n                row_version = row_version + 1,\n                updated_at = now()\n            WHERE org_id = $1\n              AND id = $2\n              AND deleted_at IS NULL\n              AND ($5::BIGINT IS NULL OR row_version = $5)\n            RETURNING id, org_id, display_name, external_id, row_version,\n                      created_at, updated_at, deleted_at\n            ",
